<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>s4mt</AssemblyName>
    <RootNamespace>S4MT.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Agent-oriented tools for building and inspecting The Sims 4 packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LlamaLogic.Packages" Version="3.8.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
